---
import Base from '../layouts/Base.astro';
import { games } from '../lib/games';
---

<Base>
  <section id="games" class="section">
    <div class="section-head">
      <div class="section-title">
        <h2>Games</h2>
        <p class="section-lede">Every WeLuvSnakes title, playable in your browser.</p>
      </div>
    </div>

    <div class:list={{ 'game-library': true, 'is-empty': games.length === 0 }}>
      <ul class="game-grid">
        {games.map((game) => (
          <li class="game-card">
            <a href={`/play/${game.slug}/`}>
              <span class="game-icon">
                <img src={game.icon} alt="" width="64" height="64" loading="lazy" />
              </span>
              <div class="game-info">
                <h3>{game.name}</h3>
                <span class="meta">Play in browser</span>
              </div>
              <span class="game-go" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      {games.length === 0 && (
        <p class="game-empty meta">The first one is in the works. Check back soon.</p>
      )}
    </div>
  </section>

  <section id="about" class="section about">
    <div class="about-mark">
      <img
        src="/img/weluvsnakes-logo.png"
        alt="The WeLuvSnakes logo"
        width="345"
        height="426"
        loading="lazy"
      />
    </div>
    <div class="about-body">
      <h2>About the studio</h2>
      <p>
        WeLuvSnakes is a small independent studio. We make strategy games and strange little
        worlds, then put them straight in the browser so you can play without installing anything.
      </p>
    </div>
  </section>
</Base>

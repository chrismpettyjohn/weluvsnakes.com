---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Full-viewport layout for the game player: no site header, container or footer. */
  full?: boolean;
}

const { title, description = SITE.description, type = 'website', full = false } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/img/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class:list={{ 'player-body': full }}>
    {
      full ? (
        <slot />
      ) : (
        <>
          <a class="skip" href="#main">
            Skip to content
          </a>
          <header class="site-head">
            <div class="site-head-inner">
              <a class="site-brand" href="/">
                <span class="brand-mark">
                  <img
                    src="/img/weluvsnakes-mark.png"
                    alt=""
                    width="306"
                    height="272"
                  />
                </span>
                <span class="site-name">{SITE.name}</span>
              </a>
              <nav aria-label="Main">
                <ul class="site-nav">
                  <li><a href="/#games">Games</a></li>
                  <li><a href="/#about">About</a></li>
                  <li><a href={SITE.github} rel="me noopener">GitHub</a></li>
                </ul>
              </nav>
            </div>
          </header>

          <main class="container" id="main">
            <slot />
          </main>

          <footer class="footer">
            <div class="footer-inner">
              <span>© {new Date().getFullYear()} {SITE.name}</span>
              <ul class="footer-links">
                <li><a href="/#games">Games</a></li>
                <li><a href={SITE.github} rel="me noopener">GitHub</a></li>
                <li><a href="/sitemap-index.xml">Sitemap</a></li>
              </ul>
            </div>
          </footer>
        </>
      )
    }
  </body>
</html>
